# Liara AI DevOps Agent — Phase 1A (read-only foundation).
# Copy to .env.local (git-ignored). NEVER commit real values.
# Every secret below is intentionally empty. Defaults run the app in MOCK mode with no Liara credentials.

# ── Data source ────────────────────────────────────────────────────────────
# mock = simulated, sanitized fixtures (no network, no credentials)
# live = READ-ONLY calls to the Liara API using the server-side token below
LIARA_DATA_SOURCE=mock

# ── Operator login (required to sign in; with no hash set, login is disabled — fail closed) ──
# Generate with:  npm run hash-password      (paste the printed, \$-escaped line here EXACTLY — single quotes do NOT protect $ from Next)
APP_ACCESS_PASSWORD_HASH=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Set true ONLY behind a reverse proxy you control that overwrites X-Forwarded-For / X-Forwarded-Host
# (Liara's platform proxy does). Enables per-client login throttling; otherwise one global bucket is used.
TRUST_PROXY_HEADERS=false

# ── Live read-only connection (ignored in mock mode) ───────────────────────
# Comma-separated Liara app names this dashboard may read. REQUIRED for live mode. "*" is rejected.
# In mock mode, leave empty to allow all simulated demo apps.
LIARA_ALLOWED_APPS=
# Create the token in the Liara console. Prefer a dedicated team/account used only for this tool.
LIARA_API_TOKEN=
# Only https://api.liara.ir is accepted (trusted-host list in src/server/config/env.ts).
LIARA_API_BASE_URL=https://api.liara.ir
# Optional team scope; sent as the `teamID` query parameter (convention observed in the official CLI — unverified).
LIARA_TEAM_ID=
LIARA_REQUEST_TIMEOUT_MS=10000
LIARA_MAX_CONCURRENCY=4
LIARA_MAX_RPS=5
# Rolling cap on upstream attempts per minute (retries count). 10–600.
LIARA_REQUEST_BUDGET_PER_MINUTE=120

# ── Logs API selection ─────────────────────────────────────────────────────
# v1   = documented endpoint (default)
# v2|auto = CLI-observed, UNDOCUMENTED endpoint; also requires LIARA_ALLOW_UNDOCUMENTED_ENDPOINTS=true
LIARA_LOGS_API=v1
LIARA_ALLOW_UNDOCUMENTED_ENDPOINTS=false

# ── Safety ─────────────────────────────────────────────────────────────────
# Phase 1A has NO write capability. Any value other than false is rejected at startup.
ENABLE_MUTATIONS=false

# ── Operator tooling (read-only; both are no-ops unless explicitly approved on the command line) ──
# npm run verify:liara-readonly -- --app=<allowlisted app> --approve-live-readonly
# Recording sanitised fixtures needs this AND --approve-recording (double opt-in). Leave false normally.
LIARA_ALLOW_RECORDING=false

# ── Diagnostic assistant (Phase 1C — OFFLINE) ──────────────────────────────
# AI is simulated only. NO paid or live AI request exists in this build.
#   mock     = deterministic, offline, clearly labelled "simulated" (default)
#   disabled = the assistant still produces the deterministic report, without any narrative
AI_PROVIDER=mock
# Must stay false. Any other value is rejected at startup (there is no live AI client to enable).
AI_LIVE_REQUESTS_ENABLED=false
# SQLite file for diagnostic run records (sanitised metadata/findings only; never tokens or raw responses).
DIAGNOSTICS_DB_PATH=./data/diagnostics.sqlite
DIAGNOSTICS_RUN_TIMEOUT_SECONDS=30
DIAGNOSTICS_MAX_CONCURRENT_RUNS=2

# ── Live deployment executor (Phase 2A — DEFAULT OFF; see docs/LIVE_DEPLOYMENT_EXECUTOR.md) ──
# A flag alone never authorises a write: a fresh live approval for the exact operation is also required.
# Needs LIARA_DATA_SOURCE=live and a token. Leave false until docs/FIRST_REAL_DEPLOYMENT_CHECKLIST.md is complete.
LIARA_LIVE_DEPLOY_ENABLED=false
# Operator attestation that the CLI-observed write fields (bundlePlanID, network, platformConfig, build) were checked.
LIARA_LIVE_CONTRACT_ATTESTED=false
# Network _id the official CLI sends on every create (GET v1/networks). Never guessed by the tool.
LIARA_NETWORK_ID=
# Operator-verified plan units and billing semantics (JSON; schema in the docs). Empty = creation blocked, no prices shown.
LIARA_PLAN_UNITS_JSON=
# Trusted default app domain suffix(es) for the post-deployment health probe, comma separated (e.g. the Liara default domain).
LIARA_APP_DOMAIN_SUFFIXES=
LIARA_LIVE_HEALTH_PATH=/health
LIARA_LIVE_HEALTH_MARKER=
# Phase 2B: allow an EMPTY LIARA_ALLOWED_APPS with live data (an account with zero applications). Effective scope = only apps this tool created and verified. Never a wildcard.
LIARA_FIRST_APP_BOOTSTRAP=false
# (Phase 2B) The network list (GET /v1/networks) is CLI-observed only: reading it needs LIARA_ALLOW_UNDOCUMENTED_ENDPOINTS=true. Plan-units JSON may also carry
# "acceptedUnknowns" (billing_start, minimum_balance, zero_balance_behavior, bundle_plan_price, vat) = a RISK ACCEPTANCE, never an attestation.
# ── Phase 2D: optional restricted official-CLI deployment backend (DEFAULT OFF; see docs/DEPLOYMENT_BACKEND_DECISION.md) ──
# Pin the tool: absolute path of the installed @liara/cli entry script, its SHA-256 and its exact version. A flag alone does nothing.
LIARA_CLI_ENABLED=false
LIARA_CLI_ENTRY=
LIARA_CLI_ENTRY_SHA256=
LIARA_CLI_VERSION=
LIARA_CLI_TIMEOUT_SECONDS=120

