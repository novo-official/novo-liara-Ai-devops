{
  "name": "liara-devops-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Persian-first AI DevOps agent for Liara — Phase 1A: read-only foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "hash-password": "tsx --conditions=react-server scripts/hash-password.ts",
    "record-fixtures": "tsx --conditions=react-server scripts/record-fixtures.ts",
    "verify:liara-readonly": "tsx --conditions=react-server scripts/verify-liara-readonly.ts",
    "preflight:liara": "tsx --conditions=react-server scripts/preflight-liara.ts",
    "check:live-settings": "tsx --conditions=react-server scripts/check-live-settings.ts",
    "ai:smoke": "tsx --conditions=react-server scripts/ai-smoke.ts",
    "demo:zip": "tsx scripts/make-demo-zip.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vazirmatn": "^33.0.3",
    "vitest": "^5.0.5"
  }
}
